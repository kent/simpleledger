# OpenAI key is server-side only. Do not put this in client code.
OPENAI_API_KEY=

# Optional extra gate for the mobile app proxy call.
AI_COACH_PROXY_TOKEN=

# Optional model override. Default is the GPT-5.2 thinking model.
AI_COACH_MODEL=gpt-5.2

# Optional reasoning effort for GPT-5.2 family: medium | high | xhigh
AI_COACH_REASONING_EFFORT=high
