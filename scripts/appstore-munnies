#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

APPSTORE_LOCAL_ENV_FILE="${APPSTORE_LOCAL_ENV_FILE:-$ROOT_DIR/fastlane/.env.local}"
APPSTORE_ENV_FILE="${APPSTORE_ENV_FILE:-$ROOT_DIR/fastlane/.env}"
DEFAULT_FASTLANE_USER="${FASTLANE_USER:-kent.fenwick@gmail.com}"
DEFAULT_FASTLANE_TEAM_ID="${FASTLANE_TEAM_ID:-PS5W7BFTQ2}"
DEFAULT_FASTLANE_ITC_TEAM_ID="${FASTLANE_ITC_TEAM_ID:-150077}"
DEFAULT_FASTLANE_ITC_TEAM_NAME="${FASTLANE_ITC_TEAM_NAME:-Kent Fenwick}"
DEFAULT_ASC_KEY_ID="${ASC_KEY_ID:-2XG664G4GG}"
DEFAULT_ASC_ISSUER_ID="${ASC_ISSUER_ID:-69a6de6e-8f71-47e3-e053-5b8c7c11a4d1}"
DEFAULT_TESTFLIGHT_GROUPS="${TESTFLIGHT_GROUPS:-Internal Testers}"
DEFAULT_APP_STORE_PRICE_TIER="${APP_STORE_PRICE_TIER:-2}"

if [[ -d /opt/homebrew/opt/ruby/bin ]]; then
  export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
fi

export BUNDLE_GEMFILE="$ROOT_DIR/Gemfile"
export BUNDLE_PATH="${BUNDLE_PATH:-$ROOT_DIR/vendor/bundle}"
export FASTLANE_SKIP_UPDATE_CHECK=1
export FASTLANE_HIDE_TIMESTAMP=1
export FASTLANE_DISABLE_COLORS="${FASTLANE_DISABLE_COLORS:-1}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"
export LANG="${LANG:-en_US.UTF-8}"

load_env_file() {
  local env_file="$1"
  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
  fi
}

load_local_env() {
  load_env_file "$APPSTORE_ENV_FILE"
  load_env_file "$APPSTORE_LOCAL_ENV_FILE"
}

detect_key_file() {
  local key_id="$1"
  local candidate
  local candidates=(
    "$HOME/.keys/AuthKey_${key_id}.p8"
    "$HOME/.appstoreconnect/private_keys/AuthKey_${key_id}.p8"
    "$HOME/.private_keys/AuthKey_${key_id}.p8"
    "$HOME/private_keys/AuthKey_${key_id}.p8"
  )

  for candidate in "${candidates[@]}"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

home_relative_path() {
  local value="$1"
  if [[ "$value" == "$HOME/"* ]]; then
    printf '~/%s\n' "${value#"$HOME/"}"
  else
    printf '%s\n' "$value"
  fi
}

shell_quote() {
  local value="$1"
  value="${value//\'/\'\\\'\'}"
  printf "'%s'" "$value"
}

setup_local_env() {
  local force="${APPSTORE_SETUP_FORCE:-0}"
  local key_id="${ASC_KEY_ID:-$DEFAULT_ASC_KEY_ID}"
  local issuer_id="${ASC_ISSUER_ID:-$DEFAULT_ASC_ISSUER_ID}"
  local key_file="${ASC_KEY_FILE:-}"

  if [[ -z "$key_file" ]]; then
    key_file="$(detect_key_file "$key_id" || true)"
  fi

  if [[ -z "$key_file" ]]; then
    key_file="\$HOME/.keys/AuthKey_${key_id}.p8"
  else
    key_file="$(home_relative_path "$key_file")"
  fi

  if [[ -f "$APPSTORE_LOCAL_ENV_FILE" && "$force" != "1" ]]; then
    echo "Local config already exists at $APPSTORE_LOCAL_ENV_FILE"
    echo "Set APPSTORE_SETUP_FORCE=1 to overwrite it."
    return 0
  fi

  mkdir -p "$(dirname "$APPSTORE_LOCAL_ENV_FILE")"

  cat > "$APPSTORE_LOCAL_ENV_FILE" <<EOF
# Generated by scripts/appstore-munnies setup-local
# Safe to edit locally. This file is ignored by git.

ASC_KEY_ID=$(shell_quote "$key_id")
ASC_ISSUER_ID=$(shell_quote "$issuer_id")
ASC_KEY_FILE=$key_file

FASTLANE_USER=$(shell_quote "$DEFAULT_FASTLANE_USER")
FASTLANE_TEAM_ID=$(shell_quote "$DEFAULT_FASTLANE_TEAM_ID")
FASTLANE_ITC_TEAM_ID=$(shell_quote "$DEFAULT_FASTLANE_ITC_TEAM_ID")
FASTLANE_ITC_TEAM_NAME=$(shell_quote "$DEFAULT_FASTLANE_ITC_TEAM_NAME")

TESTFLIGHT_GROUPS=$(shell_quote "$DEFAULT_TESTFLIGHT_GROUPS")
APP_STORE_PRICE_TIER=$(shell_quote "$DEFAULT_APP_STORE_PRICE_TIER")
EOF

  echo "Wrote local App Store config to $APPSTORE_LOCAL_ENV_FILE"
  local expanded_key_file="${key_file/#\~/$HOME}"
  if [[ -f "$expanded_key_file" ]]; then
    echo "Detected App Store Connect key at $expanded_key_file"
  else
    echo "No App Store Connect key was found automatically."
    echo "Update ASC_KEY_FILE in $APPSTORE_LOCAL_ENV_FILE before running doctor."
  fi

  echo
  echo "Next steps:"
  echo "  ./scripts/appstore-munnies doctor"
  echo "  ./scripts/appstore-munnies release"
}

print_config() {
  load_local_env
  local resolved_key_file="${ASC_KEY_FILE:-}"
  echo "App Store local config"
  echo "  env file: $APPSTORE_LOCAL_ENV_FILE"
  echo "  apple id: ${FASTLANE_USER:-$DEFAULT_FASTLANE_USER}"
  echo "  portal team: ${FASTLANE_TEAM_ID:-$DEFAULT_FASTLANE_TEAM_ID}"
  echo "  itc team: ${FASTLANE_ITC_TEAM_ID:-$DEFAULT_FASTLANE_ITC_TEAM_ID}"
  echo "  api key id: ${ASC_KEY_ID:-}"
  echo "  api issuer: ${ASC_ISSUER_ID:-}"
  echo "  api key file: ${resolved_key_file:-<unset>}"
  echo "  testflight groups: ${TESTFLIGHT_GROUPS:-$DEFAULT_TESTFLIGHT_GROUPS}"
  echo "  price tier: ${APP_STORE_PRICE_TIER:-$DEFAULT_APP_STORE_PRICE_TIER}"
}

ensure_bundle() {
  if ! command -v bundle >/dev/null 2>&1; then
    echo "bundle is not installed. Install Homebrew Ruby/Bundler first." >&2
    exit 1
  fi
}

ensure_dependencies() {
  ensure_bundle
  if ! bundle check >/dev/null 2>&1; then
    bundle install
  fi
}

command="${1:-help}"
shift || true

case "$command" in
  setup-local|help|-h|--help)
    ;;
  *)
    load_local_env
    ;;
esac

case "$command" in
  setup-local)
    setup_local_env
    ;;
  config)
    print_config
    ;;
  bootstrap)
    ensure_bundle
    bundle install
    ;;
  doctor)
    ensure_dependencies
    bundle exec fastlane ios doctor "$@"
    ;;
  status)
    ensure_dependencies
    bundle exec fastlane ios status "$@"
    ;;
  build)
    ensure_dependencies
    bundle exec fastlane ios build_release "$@"
    ;;
  release)
    ensure_dependencies
    bundle exec fastlane ios prepare_beta "$@"
    ;;
  testflight)
    ensure_dependencies
    bundle exec fastlane ios beta "$@"
    ;;
  beta)
    ensure_dependencies
    bundle exec fastlane ios beta "$@"
    ;;
  prepare-beta)
    ensure_dependencies
    bundle exec fastlane ios prepare_beta "$@"
    ;;
  metadata)
    ensure_dependencies
    bundle exec fastlane ios metadata "$@"
    ;;
  screenshots)
    ensure_dependencies
    bundle exec fastlane ios screenshots "$@"
    ;;
  price)
    ensure_dependencies
    bundle exec fastlane ios price "$@"
    ;;
  download-metadata)
    ensure_dependencies
    bundle exec fastlane ios download_metadata "$@"
    ;;
  help|-h|--help)
    cat <<'EOF'
Usage: scripts/appstore-munnies <command> [fastlane options]

Commands:
  setup-local       Create fastlane/.env.local with the local App Store defaults
  config            Print the resolved local App Store config
  bootstrap         Install the pinned fastlane gems into vendor/bundle
  doctor            Validate Ruby, Xcode, and auth inputs
  status            Print an App Store Connect status snapshot
  build             Build the signed App Store archive and IPA
  release           Build and upload a TestFlight build using local defaults
  testflight        Upload the latest IPA to internal TestFlight
  beta              Upload the latest IPA to internal TestFlight
  prepare-beta      Build and upload in one command
  metadata          Upload App Store metadata and screenshots
  screenshots       Upload screenshots only
  price             Update the App Store price tier
  download-metadata Download metadata and screenshots from App Store Connect

This script auto-loads:
  fastlane/.env
  fastlane/.env.local

Examples:
  scripts/appstore-munnies setup-local
  scripts/appstore-munnies config
  scripts/appstore-munnies bootstrap
  scripts/appstore-munnies status
  scripts/appstore-munnies release
  scripts/appstore-munnies metadata
  scripts/appstore-munnies price price_tier:2
EOF
    ;;
  *)
    echo "Unknown command: $command" >&2
    echo "Run scripts/appstore-munnies --help for usage." >&2
    exit 1
    ;;
esac
